<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <queries>
        <package android:name="com.bilibili.priconne" />
        <package android:name="com.bilibili.priconne.mi" />
        <package android:name="com.bilibili.priconne.huawei" />
        <package android:name="com.bilibili.priconne.vivo" />
        <package android:name="com.bilibili.priconne.nearme.gamecenter" />
        <package android:name="com.bilibili.priconne.aligames" />
        <package android:name="com.bilibili.priconne.m4399" />
        <package android:name="com.bilibili.priconne.yofun.mumu" />
        <package android:name="com.tencent.tmgp.bilibili.priconne" />
    </queries>

    <!--
        largeHeap raises this process's Dalvik heap limit (192 MB on the reporting device).
        Screen capture holds several full-resolution ARGB frames at once: one 1920x1080 frame is
        8.3 MB as an int[] plus 8.3 MB as a Bitmap, and recognition keeps the previous frame for
        the viewport-stability check. 2026-09-20 live: "Failed to allocate a 8294416 byte
        allocation with 7140992 free bytes ... growth limit 201326592" stopped capture outright.
        This is a headroom change, not a leak fix - the per-frame pixel buffer is pooled in
        MediaProjectionCaptureService so the steady state no longer churns 8 MB per frame.
    -->
    <application
        android:name=".LandosolToolboxApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LandosolToolbox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".automation.accessibility.LandosolAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/landosol_accessibility_service" />
        </service>

        <service
            android:name=".automation.capture.MediaProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".labyrinth.LabyrinthRerollService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".automation.overlay.AutomationNotificationActionReceiver"
            android:exported="false" />
    </application>

</manifest>
